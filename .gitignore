# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables
.env

# Configuration
# Real config holds live hostnames and credentials. Only the template is
# tracked, so ignore every variant (config.test.yaml, config.local.yaml, ...)
# rather than just the default filename.
config/config*.yaml
!config/config.example.yaml

# Secrets
/secrets/

# Metric history data
data/

# Temporary files
/tmp/

# Test cache
.pytest_cache/
.coverage
htmlcov/

# IDE
.idea/*
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.egg-info/
dist/
build/

# Logs
*.log
